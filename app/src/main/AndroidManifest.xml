<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>

    <application
        android:name=".AppMathBrainer"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:screenOrientation="portrait"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".feat_home.presentation.ui.HomeGameActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".feat_credits.presentation.ui.GameCreditsActivity">
        </activity>

        <activity
            android:name=".feat_statistics.presentation.ui.HighscoresActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait">
        </activity>

        <activity
            android:name=".feat_games.feat_math_op_write.presentation.ui.Math_Op_Write_Result_Activity"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden" />
        <activity
            android:name=".feat_games.feat_count_items.presentation.ui.CountObjectsActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait" />
        <activity
            android:name=".feat_games.feat_math_op_double.presentation.ui.DoubleNumberActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:theme="@style/AppThemeNoActionBar"
            android:windowSoftInputMode="stateHidden" />
        <activity
            android:name=".feat_games.feat_falling_op.presentation.ui.FallingOperationsActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait" />
        <activity
            android:name=".feat_games.feat_number_order.presentation.ui.NumberOrderActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait" />
        <activity
            android:name=".feat_games.feat_math_random_operation.presentation.ui.RandomOperationActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait" />
        <activity
            android:name=".feat_games.feat_sound_seq.presentation.ui.SoundsSeqActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait" />
        <activity android:name=".feat_games.feat_math_op_choose.presentation.ui.Math_Op_Choose_Result_Activity" />

        <!-- ADMOB -->
        <!-- Sample AdMob App ID:        ca-app-pub-3940256099942544~3347511713 -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_key_app_id" />


        <!-- test lib -->
        <uses-library android:name="android.test.runner"
            android:required="false" />
        <uses-library android:name="android.test.base"
            android:required="false" />
        <uses-library android:name="android.test.mock"
            android:required="false" />
    </application>

</manifest>