# frozen_string_literal: true

require "fileutils"
require "digest"

skip_docs

platform :android do
  APP_PACKAGE_NAME = "eu.indiewalkabout.mathbrainer".freeze
  RELEASE_AAB_PATH = File.join("app", "build", "outputs", "bundle", "release", "app-release.aab")
  RELEASE_AAB_CHECKSUM_PATH = "#{RELEASE_AAB_PATH}.sha256"
  STORE_MEDIA_ROOT = File.join("store-media", "google-play")
  FASTLANE_METADATA_ROOT = File.join("fastlane", "metadata", "android")
  SELECTION_FILE = File.join(STORE_MEDIA_ROOT, "promotional-screenshots", "SELECTION.md")
  RELEASE_NOTES = {
    "en-US" => <<~NOTES,
      Improved layouts across phones and tablets.
      More consistent keypad sizing in every game.
      Refreshed app icon and navigation.
      Safer consent and ad handling.
      Better preservation of statistics during upgrades.
      General stability improvements.
    NOTES
    "it-IT" => <<~NOTES
      Layout migliorati su smartphone e tablet.
      Dimensioni del tastierino più uniformi in tutti i giochi.
      Icona e navigazione rinnovate.
      Gestione più sicura del consenso e degli annunci.
      Migliore conservazione delle statistiche durante gli aggiornamenti.
      Miglioramenti generali della stabilità.
    NOTES
  }.freeze
  STORE_LOCALES = {
    "en-US" => "en",
    "it-IT" => "it"
  }.freeze

  def project_root
    File.expand_path("..", __dir__)
  end

  def copy_required_file(source_path, destination_path)
    absolute_source = File.join(project_root, source_path)
    absolute_destination = File.join(project_root, destination_path)

    UI.user_error!("Required store asset not found: #{absolute_source}") unless File.exist?(absolute_source)
    FileUtils.mkdir_p(File.dirname(absolute_destination))
    FileUtils.cp(absolute_source, absolute_destination)
  end

  def selected_phone_screenshot_names
    absolute_selection = File.join(project_root, SELECTION_FILE)
    selection_text = File.read(absolute_selection)
    selected = selection_text
      .scan(/`([^`]+\.png)`/)
      .flatten
      .uniq
      .take(8)
    UI.user_error!("No phone screenshots selected in #{absolute_selection}") if selected.empty?
    selected
  end

  def verify_release_aab!
    absolute_aab_path = File.join(project_root, RELEASE_AAB_PATH)
    absolute_checksum_path = File.join(project_root, RELEASE_AAB_CHECKSUM_PATH)
    UI.user_error!("Missing release bundle: #{absolute_aab_path}") unless File.size?(absolute_aab_path)
    UI.user_error!("Missing release checksum: #{absolute_checksum_path}") unless File.size?(absolute_checksum_path)

    expected_sha256 = File.read(absolute_checksum_path).split.first
    actual_sha256 = Digest::SHA256.file(absolute_aab_path).hexdigest
    UI.user_error!("Invalid release checksum: #{absolute_checksum_path}") unless expected_sha256&.match?(/\A[0-9a-f]{64}\z/)
    UI.user_error!("Release AAB changed after verification.") unless expected_sha256 == actual_sha256

    absolute_aab_path
  end

  desc "Build a signed release AAB."
  lane :build_release_bundle do
    gradle(task: "bundleRelease")
  end

  desc "Upload the already-built and checksummed release AAB to Google Play internal testing."
  lane :internal_release do
    json_key_data = ENV["PLAY_STORE_JSON_KEY"]
    UI.user_error!("Set PLAY_STORE_JSON_KEY before running this lane.") if json_key_data.to_s.empty?

    absolute_aab_path = verify_release_aab!

    upload_to_play_store(
      package_name: APP_PACKAGE_NAME,
      track: "internal",
      release_status: "completed",
      aab: absolute_aab_path,
      json_key_data: json_key_data,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Sync existing store-media assets into fastlane metadata/screenshot layout."
  lane :sync_store_media do
    project = project_root
    metadata_root = File.join(project, FASTLANE_METADATA_ROOT)
    FileUtils.rm_rf(metadata_root)

    STORE_LOCALES.each do |play_locale, source_locale|
      locale_root = File.join(FASTLANE_METADATA_ROOT, play_locale)
      image_root = File.join(locale_root, "images")

      copy_required_file(
        File.join(STORE_MEDIA_ROOT, "icon", "mathbrainer-store-icon-512.png"),
        File.join(image_root, "icon.png")
      )
      copy_required_file(
        File.join(STORE_MEDIA_ROOT, "feature-graphic", "mathbrainer-feature-graphic-1024x500.png"),
        File.join(image_root, "featureGraphic.png")
      )

      selected_phone_screenshot_names.each_with_index do |filename, index|
        copy_required_file(
          File.join(STORE_MEDIA_ROOT, "promotional-screenshots", source_locale, filename),
          File.join(image_root, "phoneScreenshots", format("%02d-%s", index + 1, filename))
        )
      end

      {
        "tablet-7-inch" => "sevenInchScreenshots",
        "tablet-10-inch" => "tenInchScreenshots"
      }.each do |source_folder, destination_folder|
        source_dir = File.join(project, STORE_MEDIA_ROOT, "promotional-screenshots", source_folder, source_locale)
        screenshots = Dir.glob(File.join(source_dir, "*.png")).sort
        UI.user_error!("No tablet screenshots found in #{source_dir}") if screenshots.empty?

        screenshots.each_with_index do |source_file, index|
          copy_required_file(
            source_file.delete_prefix("#{project}/"),
            File.join(image_root, destination_folder, format("%02d-%s", index + 1, File.basename(source_file)))
          )
        end
      end

      changelog_path = File.join(project, locale_root, "changelogs", "13.txt")
      FileUtils.mkdir_p(File.dirname(changelog_path))
      File.write(changelog_path, RELEASE_NOTES.fetch(play_locale))
    end

    UI.message("Localized store assets prepared for Fastlane at #{metadata_root}")
  end

  desc "Distribute the verified production AAB to Firebase App Distribution."
  lane :distribute_firebase do
    absolute_aab_path = verify_release_aab!
    configured_aab_path = ENV.fetch("FIREBASE_AAB_PATH", absolute_aab_path)
    UI.user_error!("FIREBASE_AAB_PATH must reference the verified production AAB.") unless File.expand_path(configured_aab_path) == File.expand_path(absolute_aab_path)

    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_APP_ID"),
      android_artifact_type: "AAB",
      android_artifact_path: absolute_aab_path,
      groups: ENV.fetch("FIREBASE_TESTER_GROUPS"),
      release_notes: RELEASE_NOTES.fetch("en-US").strip,
      service_credentials_file: ENV.fetch("GOOGLE_APPLICATION_CREDENTIALS")
    )
  end

  desc "Upload the verified AAB and localized media to Google Play production."
  lane :production_release do
    json_key_data = ENV.fetch("PLAY_PRODUCTION_JSON_KEY")
    UI.user_error!("PLAY_PRODUCTION_JSON_KEY is empty.") if json_key_data.empty?
    absolute_aab_path = verify_release_aab!
    sync_store_media

    upload_to_play_store(
      package_name: APP_PACKAGE_NAME,
      track: "production",
      release_status: "completed",
      rollout: "1.0",
      aab: absolute_aab_path,
      json_key_data: json_key_data,
      metadata_path: File.join(project_root, FASTLANE_METADATA_ROOT),
      skip_upload_apk: true,
      skip_upload_changelogs: false,
      skip_upload_metadata: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      sync_image_upload: true
    )
  end

  desc "Build and upload release AAB to Google Play."
  lane :store_release do |options|
    release_track = options[:track] || ENV["PLAY_RELEASE_TRACK"] || "internal"
    release_status = options[:release_status] || ENV["PLAY_RELEASE_STATUS"] || "completed"
    aab_path = options[:aab] || RELEASE_AAB_PATH
    prepare_assets = options.fetch(:prepare_assets, true)
    json_key_path = ENV["PLAY_STORE_JSON_KEY_PATH"]
    json_key_data = ENV["PLAY_STORE_JSON_KEY"]

    sync_store_media if prepare_assets
    build_release_bundle

    absolute_aab_path = File.join(project_root, aab_path)
    UI.user_error!("Missing release bundle: #{absolute_aab_path}") unless File.exist?(absolute_aab_path)
    UI.user_error!(
      "Set PLAY_STORE_JSON_KEY_PATH (file path) or PLAY_STORE_JSON_KEY (base64/json) before running this lane."
    ) if json_key_path.to_s.empty? && json_key_data.to_s.empty?

    upload_opts = {
      package_name: APP_PACKAGE_NAME,
      track: release_track,
      release_status: release_status,
      aab: absolute_aab_path,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
      skip_upload_metadata: false,
      skip_upload_screenshots: false
    }.compact
    upload_opts[:json_key] = json_key_path unless json_key_path.to_s.empty?
    upload_opts[:json_key_data] = json_key_data unless json_key_data.to_s.empty?

    upload_to_play_store(upload_opts)
  end
end
